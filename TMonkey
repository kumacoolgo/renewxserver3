// ==/UserScript==

/* global tf */

(function () {
    'use strict';

    const LOG_PREFIX = '[Xserver VPS 多账号续期]';

    const ACCOUNTS_KEY = 'xserver_accounts_v2';
    const CURRENT_INDEX_KEY = 'xserver_current_account_index_v2';
    const AUTO_LOGIN_KEY = 'xserver_auto_login_enabled_v2';
    const SKIP_ONCE_KEY = 'xserver_skip_auto_login_once_v2';

    let isRunning = false;

    GM_addStyle(`
        #vps-renewal-progress {
            position: fixed;
            top: 10px;
            right: 10px;
            z-index: 100000;
            background: #333;
            color: white;
            padding: 10px 12px;
            border-radius: 6px;
            font-size: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.35);
            max-width: 320px;
            line-height: 1.5;
        }

        #xserver-account-switcher {
            position: fixed;
            top: 55px;
            right: 12px;
            z-index: 100000;
            width: 280px;
            background: #fff;
            color: #222;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 12px;
            box-shadow: 0 6px 24px rgba(0,0,0,.18);
            font-size: 12px;
            line-height: 1.45;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        #xserver-account-switcher .xas-title {
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 8px;
        }

        #xserver-account-switcher select {
            width: 100%;
            height: 32px;
            margin-bottom: 8px;
            border: 1px solid #aaa;
            border-radius: 4px;
            padding: 4px;
            background: #fff;
            color: #222;
        }

        #xserver-account-switcher label {
            display: flex;
            align-items: center;
            gap: 5px;
            margin: 6px 0;
            user-select: none;
        }

        #xserver-account-switcher button {
            width: 100%;
            margin-top: 6px;
            padding: 8px 6px;
            border: 0;
            border-radius: 5px;
            color: #fff;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
        }

        #xserver-account-switcher .btn-save {
            background: #2e7d32;
        }

        #xserver-account-switcher .btn-fill {
            background: #1976d2;
        }

        #xserver-account-switcher .btn-manual {
            background: #555;
        }

        #xserver-account-switcher .btn-delete {
            background: #d32f2f;
        }

        #xserver-account-switcher .btn-clear {
            background: #b71c1c;
        }

        #xserver-account-switcher .xas-note {
            margin-top: 8px;
            color: #666;
            font-size: 11px;
        }
    `);

    function t(text) {
        const translations = {
            '正在处理登录...': { en: 'Processing login...', ja: 'ログインを処理しています...' },
            '已检测到保存凭据，正在自动登录...': { en: 'Saved credentials detected, automatically logging in...', ja: '保存された認証情報を検出しました。自動ログイン中...' },
            '自动登录已暂停，请手动登录。': { en: 'Auto login paused, please login manually.', ja: '自動ログインを一時停止しました。手動でログインしてください。' },
            '自动登录失败，请手动登录。': { en: 'Automatic login failed, please log in manually.', ja: '自動ログインに失敗しました。手動でログインしてください。' },
            '正在检查续期状态...': { en: 'Checking renewal status...', ja: '更新状況を確認しています...' },
            '未找到免费VPS。': { en: 'No free VPS found.', ja: '無料VPSが見つかりませんでした。' },
            '检测到即将过期，正在续期...': { en: 'Detected imminent expiration, renewing...', ja: '期限切れが間近であることを検出しました。更新中...' },
            '当前VPS无需续期。': { en: 'Current VPS does not require renewal.', ja: '現在のVPSは更新不要です。' },
            '检查续期状态出错，请刷新页面重试。': { en: 'Error checking renewal status, please refresh the page and try again.', ja: '更新状況の確認中にエラーが発生しました。ページをリロードして再試行してください。' },
            '正在准备续期申请...': { en: 'Preparing renewal request...', ja: '更新リクエストを準備しています...' },
            '正在确认续期协议...': { en: 'Confirming renewal agreement...', ja: '更新契約を確認しています...' },
            '尚未到续期时间，不会点击续期按钮。': { en: 'The renewal window has not opened yet. The renewal button will not be clicked.', ja: 'まだ更新可能時間ではないため、更新ボタンをクリックしません。' },
            '续期按钮当前不可用，不会点击。': { en: 'The renewal button is currently unavailable and will not be clicked.', ja: '更新ボタンは現在利用できないため、クリックしません。' },
            '续期申请页面交互失败。': { en: 'Failed to interact with the renewal request page.', ja: '更新申請ページの操作に失敗しました。' },
            '正在识别并输入验证码...': { en: 'Recognizing and entering CAPTCHA...', ja: 'CAPTCHAを認識して入力しています...' },
            '正在识别验证码，请稍候...': { en: 'Recognizing CAPTCHA, please wait...', ja: 'CAPTCHAを認識しています。しばらくお待ちください...' },
            '验证码识别完成，准备提交表单...': { en: 'CAPTCHA recognition complete, preparing to submit form...', ja: 'CAPTCHAの認識が完了しました。フォーム送信準備中...' },
            '已完成验证码填写，正在处理人机验证...': { en: 'CAPTCHA entry complete, processing human verification...', ja: 'CAPTCHA入力完了。人間認証を処理中...' },
            '等待人机验证令牌生成...': { en: 'Waiting for human verification token generation...', ja: '人間認証トークンの生成を待っています...' },
            '请手动完成 Cloudflare 验证...': { en: 'Please manually complete Cloudflare verification...', ja: 'Cloudflare認証を手動で完了してください...' },
            '验证码处理异常，请刷新页面重试。': { en: 'CAPTCHA processing error, please refresh the page and try again.', ja: 'CAPTCHA処理でエラーが発生しました。ページをリロードして再試行してください。' },
            '所有验证已完成，准备提交...': { en: 'All verifications completed, preparing to submit...', ja: 'すべての認証が完了しました。送信準備中...' },
            '找不到提交按钮，请手动提交表单': { en: 'Submit button not found, please submit the form manually.', ja: '送信ボタンが見つかりません。手動で送信してください。' },
        };

        if (!navigator?.language) return text;
        return translations[text]?.[navigator.language.slice(0, 2)] ?? text;
    }

    function showToast(message, timeout = 2800) {
        updateStatusElement(message);
        if (timeout) {
            setTimeout(removeStatusElement, timeout);
        }
    }

    function createStatusElement(message) {
        removeStatusElement();
        const statusEl = document.createElement('div');
        statusEl.id = 'vps-renewal-progress';
        statusEl.textContent = t(message);
        document.body.appendChild(statusEl);
    }

    function updateStatusElement(message) {
        const statusEl = document.getElementById('vps-renewal-progress');
        if (statusEl) {
            statusEl.textContent = t(message);
        } else {
            createStatusElement(message);
        }
    }

    function removeStatusElement() {
        const statusEl = document.getElementById('vps-renewal-progress');
        if (statusEl) statusEl.remove();
    }

    function waitForDOMReady() {
        return new Promise(resolve => {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', resolve, { once: true });
            } else {
                resolve();
            }
        });
    }

    function getAccounts() {
        const value = GM_getValue(ACCOUNTS_KEY, []);
        return Array.isArray(value) ? value : [];
    }

    function saveAccounts(accounts) {
        GM_setValue(ACCOUNTS_KEY, accounts);
    }

    function getCurrentAccountIndex() {
        const accounts = getAccounts();
        const index = Number(GM_getValue(CURRENT_INDEX_KEY, 0));
        if (!accounts.length) return 0;
        if (!Number.isInteger(index) || index < 0 || index >= accounts.length) return 0;
        return index;
    }

    function setCurrentAccountIndex(index) {
        GM_setValue(CURRENT_INDEX_KEY, Number(index) || 0);
    }

    function getCurrentAccount() {
        const accounts = getAccounts();
        const index = getCurrentAccountIndex();
        return accounts[index] || null;
    }

    function isAutoLoginEnabled() {
        return GM_getValue(AUTO_LOGIN_KEY, false) === true;
    }

    function setAutoLoginEnabled(enabled) {
        GM_setValue(AUTO_LOGIN_KEY, !!enabled);
    }

    function getLoginInputs() {
        const memberInput = document.querySelector('#memberid, input[name="memberid"]');
        const passInput = document.querySelector('#user_password, input[name="user_password"]');
        return { memberInput, passInput };
    }

    function getInputValue(el) {
        return el ? String(el.value || '').trim() : '';
    }

    function setNativeValue(el, value) {
        if (!el) return;
        el.focus();

        const prototype = Object.getPrototypeOf(el);
        const descriptor = Object.getOwnPropertyDescriptor(prototype, 'value');

        if (descriptor && descriptor.set) {
            descriptor.set.call(el, value);
        } else {
            el.value = value;
        }

        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
        el.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
    }

    function fillLoginFormWithAccount(acc) {
        if (!acc) return false;

        const { memberInput, passInput } = getLoginInputs();

        if (memberInput) {
            setNativeValue(memberInput, acc.memberid || '');
        }

        if (passInput) {
            setNativeValue(passInput, acc.user_password || '');
        }

        return !!(memberInput && passInput);
    }

    function fillLoginFormWithCurrentAccount() {
        return fillLoginFormWithAccount(getCurrentAccount());
    }

    function addOrUpdateAccount(memberid, user_password) {
        const accounts = getAccounts();

        const cleanMemberid = String(memberid || '').trim();
        const cleanPassword = String(user_password || '');

        if (!cleanMemberid || !cleanPassword) {
            throw new Error('账号或密码为空');
        }

        const existingIndex = accounts.findIndex(a => a.memberid === cleanMemberid);

        const item = {
            memberid: cleanMemberid,
            user_password: cleanPassword,
            updated_at: new Date().toISOString(),
        };

        if (existingIndex >= 0) {
            accounts[existingIndex] = {
                ...accounts[existingIndex],
                ...item,
            };
            setCurrentAccountIndex(existingIndex);
        } else {
            accounts.push(item);
            setCurrentAccountIndex(accounts.length - 1);
        }

        saveAccounts(accounts);
        return item;
    }

    function saveCurrentInputAsAccount() {
        const { memberInput, passInput } = getLoginInputs();
        const memberid = getInputValue(memberInput);
        const user_password = passInput ? String(passInput.value || '') : '';

        if (!memberid || !user_password) {
            alert('请先在登录框里输入账号和密码，再保存。');
            return false;
        }

        addOrUpdateAccount(memberid, user_password);
        renderAccountSwitcher();
        showToast('已保存当前输入为账号。');
        return true;
    }

    function deleteCurrentAccount() {
        const accounts = getAccounts();

        if (!accounts.length) {
            alert('没有可删除的账号。');
            return;
        }

        const index = getCurrentAccountIndex();
        const acc = accounts[index];

        if (!confirm(`确定删除当前账号？\n${acc?.memberid || ''}`)) return;

        accounts.splice(index, 1);
        saveAccounts(accounts);
        setCurrentAccountIndex(Math.max(0, index - 1));

        renderAccountSwitcher();
        fillLoginFormWithCurrentAccount();
        showToast('已删除当前账号。');
    }

    function clearAllAccounts() {
        if (!confirm('确定清空所有已保存账号？')) return;

        GM_deleteValue(ACCOUNTS_KEY);
        GM_deleteValue(CURRENT_INDEX_KEY);
        GM_deleteValue(AUTO_LOGIN_KEY);
        GM_deleteValue(SKIP_ONCE_KEY);

        renderAccountSwitcher();

        const { memberInput, passInput } = getLoginInputs();
        if (memberInput) setNativeValue(memberInput, '');
        if (passInput) setNativeValue(passInput, '');

        showToast('已清空所有账号。');
    }

    function clickLoginButton() {
        const loginBtn =
            document.querySelector('input[name="action_user_login"]') ||
            [...document.querySelectorAll('button, input[type="submit"], a')].find(el =>
                String(el.textContent || el.value || '').includes('ログインする')
            );

        if (loginBtn) {
            loginBtn.click();
            return true;
        }

        const form = document.querySelector('#login_area, form');
        if (form) {
            if (typeof form.requestSubmit === 'function') {
                form.requestSubmit();
            } else {
                form.submit();
            }
            return true;
        }

        return false;
    }

    function renderAccountSwitcher() {
        const old = document.getElementById('xserver-account-switcher');
        if (old) old.remove();

        const box = document.createElement('div');
        box.id = 'xserver-account-switcher';

        const title = document.createElement('div');
        title.className = 'xas-title';
        title.textContent = 'XServer 多账号';
        box.appendChild(title);

        const accounts = getAccounts();
        const currentIndex = getCurrentAccountIndex();

        const select = document.createElement('select');

        if (!accounts.length) {
            const option = document.createElement('option');
            option.value = '-1';
            option.textContent = '暂无账号：先输入后保存';
            select.appendChild(option);
        } else {
            accounts.forEach((acc, i) => {
                const option = document.createElement('option');
                option.value = String(i);
                option.textContent = `${i + 1}. ${acc.memberid}`;
                if (i === currentIndex) option.selected = true;
                select.appendChild(option);
            });
        }

        select.onchange = () => {
            const index = Number(select.value);
            if (!Number.isInteger(index) || index < 0) return;

            setCurrentAccountIndex(index);
            GM_setValue(SKIP_ONCE_KEY, true);

            const ok = fillLoginFormWithCurrentAccount();

            if (ok) {
                showToast('已切换账号，并填入登录框。');
            } else {
                showToast('已切换账号。若登录框未变化，请刷新页面。');
            }
        };

        box.appendChild(select);

        const autoLabel = document.createElement('label');
        const autoCheckbox = document.createElement('input');
        autoCheckbox.type = 'checkbox';
        autoCheckbox.checked = isAutoLoginEnabled();

        autoCheckbox.onchange = () => {
            setAutoLoginEnabled(autoCheckbox.checked);
            if (autoCheckbox.checked) {
                GM_setValue(SKIP_ONCE_KEY, false);
                showToast('已启用当前账号自动登录。');
            } else {
                showToast('自动登录已暂停，请手动登录。');
            }
        };

        autoLabel.appendChild(autoCheckbox);
        autoLabel.appendChild(document.createTextNode('启用当前账号自动登录'));
        box.appendChild(autoLabel);

        const saveBtn = document.createElement('button');
        saveBtn.className = 'btn-save';
        saveBtn.textContent = '保存当前输入为账号';
        saveBtn.onclick = () => {
            saveCurrentInputAsAccount();
        };
        box.appendChild(saveBtn);

        const fillBtn = document.createElement('button');
        fillBtn.className = 'btn-fill';
        fillBtn.textContent = '填入选中账号';
        fillBtn.onclick = () => {
            GM_setValue(SKIP_ONCE_KEY, true);
            const ok = fillLoginFormWithCurrentAccount();
            showToast(ok ? '已填入选中账号。' : '未找到登录输入框。');
        };
        box.appendChild(fillBtn);

        const manualBtn = document.createElement('button');
        manualBtn.className = 'btn-manual';
        manualBtn.textContent = '本次手动登录';
        manualBtn.onclick = () => {
            GM_setValue(SKIP_ONCE_KEY, true);
            fillLoginFormWithCurrentAccount();
            showToast('已填入当前账号，请手动点击登录。');
        };
        box.appendChild(manualBtn);

        const deleteBtn = document.createElement('button');
        deleteBtn.className = 'btn-delete';
        deleteBtn.textContent = '删除当前';
        deleteBtn.onclick = deleteCurrentAccount;
        box.appendChild(deleteBtn);

        const clearBtn = document.createElement('button');
        clearBtn.className = 'btn-clear';
        clearBtn.textContent = '清空所有账号';
        clearBtn.onclick = clearAllAccounts;
        box.appendChild(clearBtn);

        const note = document.createElement('div');
        note.className = 'xas-note';
        note.textContent = '提示：切换账号后会立刻填入登录框；避免马上自动登录，刷新一次即可用当前账号。';
        box.appendChild(note);

        document.body.appendChild(box);
    }

    async function handleLogin() {
        console.log(`${LOG_PREFIX} 当前在登录页面。`);
        updateStatusElement('正在处理登录...');

        renderAccountSwitcher();

        const current = getCurrentAccount();
        const hasError = !!document.querySelector('.errorMessage, .error, .alert');

        if (current) {
            fillLoginFormWithCurrentAccount();
        }

        const skipOnce = GM_getValue(SKIP_ONCE_KEY, false) === true;
        if (skipOnce) {
            GM_setValue(SKIP_ONCE_KEY, false);
            updateStatusElement('自动登录已暂停，请手动登录。');
            return;
        }

        if (current && isAutoLoginEnabled() && !hasError) {
            console.log(`${LOG_PREFIX} 发现当前账号，准备自动登录：${current.memberid}`);
            updateStatusElement('已检测到保存凭据，正在自动登录...');

            setTimeout(() => {
                try {
                    fillLoginFormWithCurrentAccount();
                    const ok = clickLoginButton();
                    if (!ok) throw new Error('找不到登录按钮或表单');
                } catch (e) {
                    console.error(`${LOG_PREFIX} 自动登录失败:`, e);
                    updateStatusElement('自动登录失败，请手动登录。');
                }
            }, 900);
        } else {
            console.log(`${LOG_PREFIX} 未启用自动登录或没有账号，等待手动操作。`);
            updateStatusElement('自动登录已暂停，请手动登录。');
        }

        const form = document.querySelector('#login_area, form');
        if (form) {
            form.addEventListener('submit', () => {
                try {
                    const { memberInput, passInput } = getLoginInputs();
                    const memberid = getInputValue(memberInput);
                    const user_password = passInput ? String(passInput.value || '') : '';

                    if (memberid && user_password) {
                        addOrUpdateAccount(memberid, user_password);
                        console.log(`${LOG_PREFIX} 已保存/更新账号：${memberid}`);
                    }
                } catch (e) {
                    console.error(`${LOG_PREFIX} 保存凭据时出错:`, e);
                }
            });
        }
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function normalizeText(value) {
        return String(value || '').replace(/\s+/g, ' ').trim();
    }

    function parseDateText(value) {
        const match = String(value || '').match(/(\d{4})[\/\-.年](\d{1,2})[\/\-.月](\d{1,2})/);
        if (!match) return null;

        return {
            year: Number(match[1]),
            month: Number(match[2]),
            day: Number(match[3]),
        };
    }

    function getTokyoDateParts(offsetDays = 0) {
        const date = new Date(Date.now() + offsetDays * 86400000);
        const parts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'Asia/Tokyo',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
        }).formatToParts(date);

        const values = Object.fromEntries(parts.map(part => [part.type, part.value]));
        return {
            year: Number(values.year),
            month: Number(values.month),
            day: Number(values.day),
        };
    }

    function datePartsToUtc(parts) {
        return Date.UTC(parts.year, parts.month - 1, parts.day);
    }

    function getDaysUntilTokyoDate(dateText) {
        const target = parseDateText(dateText);
        if (!target) return null;

        const today = getTokyoDateParts();
        return Math.round((datePartsToUtc(target) - datePartsToUtc(today)) / 86400000);
    }

    function isControlDisabled(element) {
        if (!element) return true;

        return Boolean(
            element.disabled ||
            element.hasAttribute('disabled') ||
            element.getAttribute('aria-disabled') === 'true' ||
            element.classList.contains('btn--disabled') ||
            element.classList.contains('is-disabled') ||
            element.classList.contains('disabled')
        );
    }

    function findExactTextControl(text, root = document) {
        return [...root.querySelectorAll('a, button, input[type="submit"], input[type="button"]')]
            .find(element => {
                const label = normalizeText(element.textContent || element.value);
                return !isControlDisabled(element) && label === text;
            }) || null;
    }

    function parseTokyoRenewalAvailableAt(pageText = document.body?.innerText || '') {
        const normalized = normalizeText(pageText);

        // 例如：
        // 「2026年7月25日 12:00以降にお試しください」
        // XServer 显示的是日本时间。JST 固定为 UTC+9。
        const match = normalized.match(
            /(\d{4})\s*年\s*(\d{1,2})\s*月\s*(\d{1,2})\s*日\s*(\d{1,2})\s*[:：]\s*(\d{2})\s*以降/
        );

        if (!match) return null;

        const year = Number(match[1]);
        const month = Number(match[2]);
        const day = Number(match[3]);
        const hour = Number(match[4]);
        const minute = Number(match[5]);

        if (
            !Number.isInteger(year) ||
            month < 1 || month > 12 ||
            day < 1 || day > 31 ||
            hour < 0 || hour > 23 ||
            minute < 0 || minute > 59
        ) {
            return null;
        }

        return {
            year,
            month,
            day,
            hour,
            minute,
            // 将日本时间转换为 UTC 时间戳进行比较。
            timestamp: Date.UTC(year, month - 1, day, hour - 9, minute, 0, 0),
        };
    }

    function formatTokyoDateTime(timestamp) {
        return new Intl.DateTimeFormat('zh-CN', {
            timeZone: 'Asia/Tokyo',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            hourCycle: 'h23',
        }).format(new Date(timestamp));
    }

    function closeCampaignModal() {
        const modal = document.querySelector('#campaignModalForFreeUsers.modal.isOpen');
        const closeButton = modal?.querySelector('.modal__close');
        if (closeButton) closeButton.click();
    }

    async function handleVPSDashboard() {
        console.log(`${LOG_PREFIX} 当前在VPS管理主页。`);
        updateStatusElement('正在检查续期状态...');

        try {
            await sleep(500);
            closeCampaignModal();

            // 不再使用 tr:has(...)，避免选择器兼容问题。
            const freeRows = [...document.querySelectorAll('table.contract__table tbody tr')]
                .filter(row => row.querySelector('.freeServerIco'));

            if (!freeRows.length) {
                console.log(`${LOG_PREFIX} 未找到免费VPS条目。`);
                updateStatusElement('未找到免费VPS。');
                return;
            }

            const candidates = freeRows.map(row => {
                const expireDate = normalizeText(row.querySelector('.contract__term')?.textContent);
                const daysRemaining = getDaysUntilTokyoDate(expireDate);
                const detailLink = row.querySelector('a[href*="/xapanel/xvps/server/detail?id="]');
                return { row, expireDate, daysRemaining, detailLink };
            });

            candidates.forEach(item => {
                console.log(
                    `${LOG_PREFIX} 免费VPS到期日=${item.expireDate || '未找到'}，剩余天数=${item.daysRemaining}`
                );
            });

            // 旧版只判断“到期日=明天”。新版免费VPS缩短为24小时后，
            // 页面可能要到“到期当天”才出现更新按钮，因此今天和明天都进入契约详情确认。
            const due = candidates.find(item =>
                item.detailLink &&
                item.daysRemaining !== null &&
                item.daysRemaining <= 1
            );

            if (!due) {
                console.log(`${LOG_PREFIX} 当前没有进入续期窗口的免费VPS。`);
                updateStatusElement('当前VPS无需续期。');
                setTimeout(removeStatusElement, 3000);
                return;
            }

            updateStatusElement('检测到即将过期，正在续期...');
            console.log(`${LOG_PREFIX} 进入契约详情页，由页面上的“更新する”按钮继续。`);
            await sleep(700);
            location.href = due.detailLink.href;
        } catch (e) {
            console.error(`${LOG_PREFIX} 在VPS管理主页处理出现错误:`, e);
            updateStatusElement('检查续期状态出错，请刷新页面重试。');
        }
    }

    async function handleVPSDetailPage() {
        console.log(`${LOG_PREFIX} 当前在VPS契约详情页。`);
        updateStatusElement('正在检查续期状态...');

        try {
            await sleep(600);

            const rows = [...document.querySelectorAll('tr')];
            const expiryRow = rows.find(row => {
                const firstCell = row.querySelector('th, td');
                return normalizeText(firstCell?.textContent) === '利用期限';
            });

            const expireDate = normalizeText(
                expiryRow?.querySelector('td:nth-child(2)')?.textContent ||
                expiryRow?.children?.[1]?.textContent
            );
            const daysRemaining = getDaysUntilTokyoDate(expireDate);
            const renewButton = expiryRow ? findExactTextControl('更新する', expiryRow) : null;

            console.log(`${LOG_PREFIX} 契约详情到期日=${expireDate || '未找到'}，剩余天数=${daysRemaining}`);

            // 以网站是否显示“更新する”为最终判断，避免继续依赖旧URL结构。
            if (renewButton && (daysRemaining === null || daysRemaining <= 1)) {
                console.log(`${LOG_PREFIX} 已找到“更新する”按钮，正在进入续期申请。`);
                updateStatusElement('检测到即将过期，正在续期...');
                await sleep(700);
                renewButton.click();
                return;
            }

            console.log(`${LOG_PREFIX} 当前详情页没有可用的续期按钮。`);
            updateStatusElement('当前VPS无需续期。');
            setTimeout(removeStatusElement, 3000);
        } catch (e) {
            console.error(`${LOG_PREFIX} 契约详情页处理失败:`, e);
            updateStatusElement('检查续期状态出错，请刷新页面重试。');
        }
    }

    async function handleRenewalPage() {
        console.log(`${LOG_PREFIX} 当前在续期申请页面。`);
        updateStatusElement('正在准备续期申请...');

        try {
            await sleep(800);

            // 首先读取页面给出的准确开放时间，例如：
            // “2026年7月25日 12:00以降にお試しください”。
            // 必须到该日本时间以后才允许点击。
            const availableAt = parseTokyoRenewalAvailableAt();

            if (availableAt && Date.now() < availableAt.timestamp) {
                const availableText = formatTokyoDateTime(availableAt.timestamp);
                const remainingMinutes = Math.ceil((availableAt.timestamp - Date.now()) / 60000);

                console.log(
                    `${LOG_PREFIX} 尚未进入续期窗口。日本时间 ${availableText} 后可续期，` +
                    `约剩余 ${remainingMinutes} 分钟。`
                );

                updateStatusElement(
                    `尚未到续期时间，不会点击续期按钮。日本时间 ${availableText} 后可续期。`
                );
                return;
            }

            const extendButton =
                document.querySelector('[formaction*="/xapanel/xvps/server/freevps/extend/conf"]') ||
                [...document.querySelectorAll('button, input[type="submit"], a')].find(element =>
                    normalizeText(element.textContent || element.value).includes('引き続き無料VPSの利用を継続する')
                );

            if (!extendButton) {
                throw new Error('未找到续期确认按钮');
            }

            // XServer 现在不是只用 disabled 属性，而是会加 btn--disabled 类。
            // 即使浏览器允许 click()，也绝不能在按钮不可用时强行提交。
            if (isControlDisabled(extendButton)) {
                console.log(`${LOG_PREFIX} 续期按钮仍处于禁用状态，不执行点击。`);
                updateStatusElement('续期按钮当前不可用，不会点击。');
                return;
            }

            // 如果页面没有显示开放时间，也至少按日本当前时间再次确认：
            // 页面按钮已经启用，并且现在确实处于日本时间环境下再继续。
            const tokyoNow = new Intl.DateTimeFormat('zh-CN', {
                timeZone: 'Asia/Tokyo',
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hourCycle: 'h23',
            }).format(new Date());

            console.log(`${LOG_PREFIX} 日本当前时间=${tokyoNow}，续期按钮已启用，准备点击。`);
            updateStatusElement('正在确认续期协议...');
            await sleep(600);

            // 点击前最后再检查一次，防止页面状态在等待期间发生变化。
            if (isControlDisabled(extendButton)) {
                console.log(`${LOG_PREFIX} 点击前按钮变为不可用，已取消点击。`);
                updateStatusElement('续期按钮当前不可用，不会点击。');
                return;
            }

            extendButton.click();
        } catch (e) {
            console.error(`${LOG_PREFIX} 续期确认按钮处理异常:`, e);
            updateStatusElement('续期申请页面交互失败。');
        }
    }

    function decodeCaptcha(predictionTensor) {
        const blankIndex = predictionTensor.shape[2] - 1;
        const bestPath = predictionTensor.argMax(-1).dataSync();
        const digits = [];
        let previous = blankIndex;

        for (const index of bestPath) {
            if (index !== blankIndex && index !== previous) {
                digits.push(String(index));
            }
            previous = index;
        }

        return digits.join('');
    }

    async function imageToCode(img) {
        await tf.ready();

        const model = await tf.loadLayersModel(
            'https://github30.github.io/captcha-cloudrun/web_model/model.json?v=20260407-2'
        );

        return tf.tidy(() => {
            const tensor = tf.browser
                .fromPixels(img)
                .resizeBilinear([60, 300])
                .toFloat()
                .div(255)
                .expandDims(0);

            return decodeCaptcha(model.predict(tensor));
        });
    }

    async function handleCaptchaPage() {
        console.log(`${LOG_PREFIX} 当前在验证码/确认页面，开始处理...`);
        updateStatusElement('正在识别并输入验证码...');

        try {
            await waitForDOMReady();

            // 如果服务器返回“某个日本时间以后再试”的错误页，
            // 立即停止，不再把该页面误判成验证码页面。
            const availableAt = parseTokyoRenewalAvailableAt();
            if (availableAt && Date.now() < availableAt.timestamp) {
                const availableText = formatTokyoDateTime(availableAt.timestamp);
                console.log(`${LOG_PREFIX} 服务器尚未开放续期，日本时间 ${availableText} 后再试。`);
                updateStatusElement(
                    `尚未到续期时间，不会点击续期按钮。日本时间 ${availableText} 后可续期。`
                );
                return;
            }

            const img =
                document.querySelector('img[src^="data:image"]') ||
                document.querySelector('img[src^="data:"]');

            if (!img || !img.src) {
                throw new Error('未找到验证码图片');
            }

            console.log(`${LOG_PREFIX} 已找到验证码图片，正在识别...`);
            updateStatusElement('正在识别验证码，请稍候...');

            let codeResponse = '';
            const maxRetries = 3;

            for (let retryCount = 0; retryCount < maxRetries; retryCount++) {
                try {
                    codeResponse = await imageToCode(img);
                    if (codeResponse && codeResponse.length >= 4) break;
                    throw new Error('验证码识别结果无效');
                } catch (err) {
                    if (retryCount >= maxRetries - 1) throw err;
                    console.log(`${LOG_PREFIX} 验证码识别失败，重试 ${retryCount + 1}/${maxRetries}`);
                }
            }

            const code = String(codeResponse || '').trim();

            if (!code || code.length < 4) {
                throw new Error('未接收到有效验证码或验证码太短');
            }

            console.log(`${LOG_PREFIX} 验证码: ${code}`);
            updateStatusElement('验证码识别完成，准备提交表单...');

            const input =
                document.querySelector('[placeholder*="上の画像"]') ||
                document.querySelector('input[name*="captcha"], input[type="text"]');

            if (!input) {
                throw new Error('未找到验证码输入框');
            }

            setNativeValue(input, code);

            console.log(`${LOG_PREFIX} 已将验证码填入输入框。`);
            updateStatusElement('已完成验证码填写，正在处理人机验证...');

            const cf =
                document.querySelector('[name="cf-turnstile-response"]') ||
                document.querySelector('textarea[name="cf-turnstile-response"]');

            if (!cf) {
                console.warn(`${LOG_PREFIX} 未检测到 Cloudflare Turnstile，直接提交。`);
                submitForm();
                return;
            }

            if (cf.value) {
                console.log(`${LOG_PREFIX} Cloudflare 令牌已存在，直接提交。`);
                submitForm();
                return;
            }

            console.log(`${LOG_PREFIX} 等待用户手动完成 Cloudflare 验证...`);
            updateStatusElement('请手动完成 Cloudflare 验证...');

            const observer = new MutationObserver(() => {
                if (cf.value) {
                    console.log(`${LOG_PREFIX} Cloudflare 令牌已生成，准备提交。`);
                    observer.disconnect();
                    submitForm();
                }
            });

            observer.observe(cf, {
                attributes: true,
                attributeFilter: ['value'],
            });

            const interval = setInterval(() => {
                if (cf.value) {
                    clearInterval(interval);
                    observer.disconnect();
                    console.log(`${LOG_PREFIX} Cloudflare 令牌已生成，准备提交。`);
                    submitForm();
                }
            }, 1000);

        } catch (error) {
            console.error(`${LOG_PREFIX} 处理验证码时发生错误:`, error);
            updateStatusElement('验证码处理异常，请刷新页面重试。');
        }

        function submitForm() {
            updateStatusElement('所有验证已完成，准备提交...');

            setTimeout(() => {
                const submitBtn =
                    [...document.querySelectorAll('button, input[type="submit"], a')].find(el =>
                        String(el.textContent || el.value || '').includes('無料VPSの利用を継続する')
                    ) ||
                    document.querySelector('input[type="submit"], button[type="submit"]');

                if (submitBtn) {
                    submitBtn.click();
                } else {
                    console.error(`${LOG_PREFIX} 未找到可点击的提交按钮`);
                    updateStatusElement('找不到提交按钮，请手动提交表单');
                }
            }, 1000);
        }
    }

    function main() {
        if (isRunning) return;
        isRunning = true;

        const path = window.location.pathname;

        const isLoginPage =
            path.startsWith('/xapanel/login/xvps') ||
            (path.startsWith('/xapanel/myaccount/login') && document.querySelector('#login_area'));

        if (isLoginPage) {
            handleLogin();
        } else if (path.includes('/xapanel/xvps/index')) {
            handleVPSDashboard();
        } else if (path.includes('/xapanel/xvps/server/detail')) {
            handleVPSDetailPage();
        } else if (path.includes('/xapanel/xvps/server/freevps/extend/index')) {
            handleRenewalPage();
        } else if (
            path.includes('/xapanel/xvps/server/freevps/extend/conf') ||
            path.includes('/xapanel/xvps/server/freevps/extend/do')
        ) {
            handleCaptchaPage();
        } else {
            console.log(`${LOG_PREFIX} 当前不在已支持的路径中，脚本不会执行任何操作。`);
            isRunning = false;
        }
    }

    main();
})();
