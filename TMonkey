// @name:zh-CN   Xserver VPS 自动续期脚本 多账号版2
// @namespace    http://tampermonkey.net/
// @version      2026-07-24.2
// @description  Automatically renews the expiration date of free Xserver VPS with multi-account switch.
// @description:zh-CN Xserver 免费 VPS 自动续期，多账号切换版。
// @author       You
// @match        https://secure.xserver.ne.jp/xapanel/login/xvps/*
// @match        https://secure.xserver.ne.jp/xapanel/myaccount/login*
// @match        https://secure.xserver.ne.jp/xapanel/xvps/*
